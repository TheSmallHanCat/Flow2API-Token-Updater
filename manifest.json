{
  "manifest_version": 3,
  "name": "Flow2API Token Updater",
  "version": "1.3.2",
  "description": "自动提取Google Flow登录Cookie并更新到Flow2API系统",
  "permissions": [
    "cookies",
    "alarms",
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "http://google.com/*",
    "https://google.com/*",
    "https://*.google.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
